{
  "name": "fellowship",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:v2": "pnpm --filter web-v2 dev",
    "build": "pnpm --filter web build",
    "build:v2": "pnpm --filter web-v2 build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.86.0",
